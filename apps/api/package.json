    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.0.5",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.0.5",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.0.5",
    "@nestjs/swagger": "11.0.3",
    "@prisma/client": "6.2.1",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.0.0",
    "jose": "5.9.6",
    "nestjs-pino": "4.3.1",
    "pino-http": "10.3.0",
    "prisma": "6.2.1",
    "qrcode": "1.5.4",
