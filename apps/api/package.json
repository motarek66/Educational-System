    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.19.1",
    "@types/archiver": "6.0.3",
